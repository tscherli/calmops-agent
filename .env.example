# OpenAI (agent LLM) -- the only key the app itself needs.
OPENAI_API_KEY=

# Optional model overrides. Every station runs on gpt-5-mini, the debate
# station included: on the nano tier the stations kept ignoring prompt rules
# in hand tests. Set OPENAI_MODEL=gpt-5-nano for the cheaper run -- roughly a
# fifth of the price per token -- and raise OPENAI_DEBATE_MODEL on its own if
# the debate needs more than the rest.
# OPENAI_MODEL=gpt-5-mini
# OPENAI_DEBATE_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=low

# Kill switch for the built-in web search. With it off the tool is unbound
# everywhere AND the search station stops forcing it -- forcing a tool that
# is not bound is a 400 from the provider.
# OPENAI_ENABLE_WEB_SEARCH=false

# LangSmith tracing (optional). Leave false until you've set a real
# LANGSMITH_API_KEY below -- true with no key causes repeated 401 errors
# on every agent call, not a silent no-op.
# If your LangSmith account is in the EU region (check whether your
# dashboard URL is eu.smith.langchain.com), you MUST also set
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com below, or every
# trace fails with a 403 Forbidden even with a valid key -- the key is
# region-scoped, not just account-scoped. Leave ENDPOINT unset for the
# default US region.
LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-load-agent

# The check-in log (data/checkin_log.csv) and the measure list
# (tools/measures.csv) are local files -- no config needed.

# Google API key -- used ONLY by the eval suite's LLM judge (evals/judge.py),
# never by the app itself. Grading with a different provider from the model
# under test keeps the judge's blind spots uncorrelated with the agent's.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Override the judge model, e.g. to compare providers during calibration:
# EVAL_JUDGE_MODEL=openai:gpt-5-nano
